# ─── Mode switches ────────────────────────────────────────
STORAGE_MODE=cloud
DISPATCH_MODE=direct
MUSIC_MODE=suno

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
# Alternative: SUPABASE_KEY (service key is preferred, regular key is fallback)

# ─── LLM (Concept + Storyboard) ──────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ─── Image Generation (Gemini via google-genai SDK) ──────
GOOGLE_AI_API_KEY=AIza...
# NOTE: This is GOOGLE_AI_API_KEY, NOT GOOGLE_API_KEY.
# The image engine reads this specific variable name.

# ─── Video Generation ────────────────────────────────────
FAL_KEY=your-fal-key
# When GPU worker is ready (Prompt 05):
# VIDEO_BACKEND=self_hosted
# GPU_WORKER_URL=https://your-runpod-endpoint
#
# RunPod Serverless:
# VIDEO_BACKEND=runpod
# RUNPOD_API_KEY=your-runpod-api-key
# RUNPOD_ENDPOINT_ID=your-endpoint-id

# === RunPod Pod Automation (Level 2) ===
# Set these to enable automatic pod creation/termination.
# If GPU_WORKER_URL is set, Level 2 is bypassed (Level 1 manual mode).
# If GPU_WORKER_URL is empty AND RUNPOD_API_KEY is set, Level 2 activates.
# RUNPOD_API_KEY is shared with the Serverless block above.
# RUNPOD_VOLUME_IDS is comma-separated (enables multi-region fallback).
# RUNPOD_VOLUME_IDS=vol_abc123,vol_def456
# RUNPOD_GPU_TYPE=NVIDIA L40S
# Comma-separated fallback GPU types (all >=48GB VRAM).
# Names must match RunPod's GPUTypeId enum exactly. Ordered cheapest-first.
# RUNPOD_FALLBACK_GPU_TYPES=NVIDIA A40,NVIDIA RTX A6000,NVIDIA L40,NVIDIA RTX 6000 Ada Generation,NVIDIA A100 80GB PCIe,NVIDIA A100-SXM4-80GB,NVIDIA H100 PCIe,NVIDIA H100 80GB HBM3,NVIDIA H100 NVL
# RUNPOD_DOCKER_IMAGE=lokiii69/ltx-worker:diffusers-v1
# Seconds idle before pod termination:
# RUNPOD_IDLE_TIMEOUT=300
# Max seconds to wait for pod to report healthy after creation:
# RUNPOD_POD_STARTUP_TIMEOUT=300
# RUNPOD_POD_NAME=resonance-gpu-worker
# Max retries when RunPod returns HTTP 429 for a single pod-create POST.
# Each retry honors Retry-After (seconds or HTTP-date), capped at 120s.
# RUNPOD_429_MAX_RETRIES=3

# ─── Song (Suno via kie.ai) ──────────────────────────────
KIE_API_KEY=your-kie-key

# ─── TTS (Bookend) ───────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key

# ─── Workspace ────────────────────────────────────────────
# MUST be on a persistent volume (Railway: mount volume at /data).
# Suno retry jobs depend on workspace files surviving container restarts.
CLOUD_WORKSPACE_ROOT=/data/resonance/workspaces

# ─── Health check ─────────────────────────────────────────
# Railway injects PORT automatically. If not using Railway:
HEALTH_PORT=8091

# ─── Job Runner Tuning (optional) ─────────────────────────
# JOB_RUNNER_POLL_INTERVAL=30
# JOB_RUNNER_MAX_RETRIES=2
# JOB_RUNNER_CLEANUP=false
