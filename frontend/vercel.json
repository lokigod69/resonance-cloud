{
  "framework": "vite",
  "crons": [
    { "path": "/api/analytics-deletion-sweep", "schedule": "30 3 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/v/(.*)", "dest": "/api/share?id=$1" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/cookies", "dest": "/cookies.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/support", "dest": "/support.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
