# Vite env for the Capacitor iOS build (`npm run build:ios` → vite build --mode ios).
# No secrets in this file — these are public origins, safe to commit.
# Inside the WKWebView the origin is capacitor://localhost, so API calls and
# auth/web redirects must resolve against the live deployment explicitly.
VITE_PUBLIC_API_ORIGIN=https://lingwave.ai
VITE_PUBLIC_WEB_ORIGIN=https://lingwave.ai
VITE_NATIVE_AUTH_REDIRECT_URL=resonance://auth/callback
